#!/usr/bin/env node
'use strict';

const assert = require('node:assert/strict');
const { parseArgs, failure, success, WorkflowError, WorkflowStore, emptyState } = require('../lib/workflow');

assert.deepEqual(parseArgs(['check', '--json']), { positional: ['check'], options: {}, json: true });
assert.deepEqual(parseArgs(['start', '--task', 'TASK-1', '--title', 'title']), {
  positional: ['start'], options: { task: 'TASK-1', title: 'title' }, json: false
});
assert.deepEqual(success({ value: 1 }), { type: 'success', data: { value: 1 } });
const failed = failure(new WorkflowError('BAD', 'bad'));
assert.equal(failed.type, 'failure');
assert.deepEqual(failed.data.blocked_by, []);
assert.deepEqual(failed.data.next, []);

const state = emptyState();
state.subtasks.push({ id: 'sk-1', task: 'TASK-1' });
const store = new WorkflowStore(require('node:os').tmpdir() + `/workflow-cli-${process.pid}.json`);
store.save(state);
assert.equal(store.load().subtasks[0].id, 'sk-1');
console.log('workflow-cli-test: ok');
