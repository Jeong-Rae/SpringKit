#!/usr/bin/env node
'use strict';

const assert = require('node:assert/strict');
const fs = require('node:fs');
const { fixture, appFor, assertSuccess } = require('./test-support');

const f = fixture();
const app = appFor(f);
const started = assertSuccess(assert, app.execute(['start', '--task', 'TASK-42', '--request-id', 'one', '--title', 'first', '--json']));
const checkApp = appFor(f, started.workspace.path);
const checked = assertSuccess(assert, checkApp.execute(['check', '--json']));
assert.equal(checked.publishable, true);
assert.equal(typeof checked.fingerprint, 'string');
assert.equal(f.store.load().subtasks[0].check.fingerprint, checked.fingerprint);
fs.appendFileSync(require('node:path').join(started.workspace.path, 'change.txt'), 'changed\n');
const changed = assertSuccess(assert, checkApp.execute(['check', '--json']));
assert.notEqual(changed.fingerprint, checked.fingerprint);
console.log('workflow-check-test: ok');
